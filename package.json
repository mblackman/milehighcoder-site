{
  "name": "milehighcoder",
  "version": "1.0.0",
  "description": "Personal blog for milehighcoder.com",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "npm run css && npx @11ty/eleventy",
    "css": "tailwindcss -i ./src/_includes/css/base.css -o ./_site/output.css --minify",
    "predev": "npm run css",
    "start": "npm run predev && concurrently \"npm:dev:*\"",
    "debug": "DEBUG=Eleventy* npx @11ty/eleventy",
    "debugstart": "DEBUG=Eleventy* npx @11ty/eleventy --serve --quiet",
    "benchmark": "DEBUG=Eleventy:Benchmark* npx @11ty/eleventy",
    "dev:eleventy": "npx @11ty/eleventy --serve --quiet",
    "dev:css": "tailwindcss -i ./src/_includes/css/base.css -o ./_site/output.css --watch",
    "dev:functions": "wrangler pages dev _site",
    "d1:migrate:local": "wrangler d1 execute milehighcoder-dreams --local --file=./migrations/0001_init.sql",
    "d1:migrate:remote": "wrangler d1 execute milehighcoder-dreams --remote --file=./migrations/0001_init.sql"
  },
  "keywords": [
    "personal-site",
    "game-dev"
  ],
  "author": "Matt",
  "license": "ISC",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.0",
    "@11ty/eleventy-fetch": "^5.1.2",
    "@11ty/eleventy-plugin-rss": "^3.0.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.0",
    "@tailwindcss/cli": "^4.2.2",
    "@tailwindcss/typography": "^0.5.19",
    "clean-css": "^5.3.3",
    "concurrently": "^9.1.2",
    "daisyui": "^5.5.19",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.2.2"
  }
}
