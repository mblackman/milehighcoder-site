---
layout: layouts/default.liquid
---

<div class="flex flex-col gap-12">
  <section class="py-12 md:py-20 animate-fade-in-up">
    <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight mb-6 bg-clip-text text-transparent bg-gradient-to-r from-primary via-secondary to-accent">
      Hi, I'm {{ site.author.name }}.
    </h1>
    <p class="text-xl md:text-2xl opacity-80 leading-relaxed max-w-3xl">
      {{ site.description }}
    </p>
  </section>

  <section class="animate-fade-in-up delay-100">
    <div class="prose mb-6">
      <h2>Latest</h2>
    </div>
    {% assign posts = collections.posts | reverse %}
    {% assign count = 1 %}
    {% include "postlist.liquid" %}
  </section>

  {% comment %} {% assign tagList = collections | postTags %} {% if tagList.length > 0 %}
  <section class="prose">
    <h2>Topics</h2>
    {%- for tag in tagList -%}
    <a href="/tags/{{ tag.name }}">{{ tag.name }}({{ tag.count }})</a>{% if
    forloop.last != true %}<span>, </span>{% endif %} {%- endfor -%}
  </section>
  {% endif %} {% endcomment %}

  {% assign posts = collections.posts | reverse %} {% if posts.length > 1 %}
    <section class="animate-fade-in-up delay-300">
      <div class="prose mb-6">
        <h2>More articles</h2>
      </div>
      
      {% assign count = 5 %}
      {% assign offset = 1 %}
      {% include "postlist.liquid" %}
      <p class="text-center text-lg mt-8">
        <a class="text-primary hover:text-primary/80 font-medium underline transition-colors" href="/articles">All the articles</a>
      </p>
    </section>
  {% endif %}
</div>

