<!DOCTYPE html>
<html lang="en">
  <head>
    {% block head %}
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">


      {%if title %}
        <title>{{ title }}</title>
        <meta name="twitter:title" content="{{ title }}" />
        <meta property="og:title" content="{{ title }}" />
      {% else %}
        <title>{{ site.title }}</title>
        <meta name="twitter:title" content="{{ site.title }}" />
        <meta property="og:title" content="{{ site.title }}" />
      {% endif %} 

      {% if description %}
        <meta name="twitter:description" content="{{ description }}" />
        <meta name="description" content="{{ description }}" />
        <meta property="og:description" content="{{ description }}" />
      {% else %}
        <meta name="twitter:description" content="{{ site.description }}" />
        <meta name="description" content="{{ site.description }}" />
        <meta property="og:description" content="{{ site.description }}" />
      {% endif %} 

      <link rel="canonical" href="{{ site.url }}{{ page.url }}" />
      <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
      <meta property="og:type" content="{% if layout == 'layouts/post.liquid' %}article{% else %}website{% endif %}" />
      <meta name="twitter:card" content="summary_large_image" />

      {% if splash %}
        <meta property="og:image" content="{{ site.url }}{{ splash }}" />
        <meta name="twitter:image" content="{{ site.url }}{{ splash }}" />
      {% elsif site.ogImage %}
        <meta property="og:image" content="{{ site.url }}{{ site.ogImage }}" />
        <meta name="twitter:image" content="{{ site.url }}{{ site.ogImage }}" />
      {% endif %}

      <link rel="alternate" type="application/atom+xml" href="/rss.xml" title="{{ site.title }}" />

      <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png">
      <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png">
      <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png">
      <link rel="manifest" href="/favicon/site.webmanifest">
      <style>
        {% getCssContent %}
      </style>
    {% endblock %}
  </head>
  <body class="flex flex-col items-center justify-center bg-gradient-to-b from-base-100 to-base-300 min-h-screen">
    <a href="#skip" class="hidden">Skip to main content</a>
    <div class="p-6 max-w-4xl w-full flex-grow flex flex-col gap-6"> 
      {% include "navbar.liquid" %}
      <main class="flex-grow px-8 py-10 bg-base-100/70 backdrop-blur-xl rounded-3xl shadow-2xl border border-base-content/10" id="skip">
        {{ content }}
      </main>
      {% include "footer.liquid" %}
    </div>
  </body>
</html>
